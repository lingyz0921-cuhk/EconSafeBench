# Required only for re-running model evaluations.
# Metric regeneration from the included raw logs does not require API access.
OPENAI_API_KEY=

# Optional: set when using an OpenAI-compatible provider endpoint.
OPENAI_BASE_URL=

# Optional: LLM judge model for language-quality dimensions.
ECONSAFEBENCH_JUDGE_MODEL=claude-opus-4-6

# Optional: request timeout and LangGraph recursion limit.
LG_REQUEST_TIMEOUT=90
LG_RECURSION_LIMIT=8
